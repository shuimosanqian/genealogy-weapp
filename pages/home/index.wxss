/* 搜索区域 */
.search-section {
  margin-bottom: 32rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--color-card-bg);
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  box-shadow: var(--shadow-base);
  border: 2rpx solid var(--color-divider);
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-3);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  border: none;
  outline: none;
}

.search-btn {
  padding: 8rpx 16rpx;
  background: var(--color-brand);
  color: #fff;
  border-radius: 16rpx;
  font-size: 24rpx;
}

/* 快捷入口 */
.quick-section {
  margin-bottom: 32rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.title-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.quick-card {
  background: var(--color-card-bg);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-base);
  transition: all 200ms ease;
  border: 2rpx solid transparent;
}

.quick-card:active {
  transform: scale(0.96);
  border-color: var(--color-brand);
}

.card-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  color: var(--color-text);
}

.card-desc {
  font-size: 22rpx;
  color: var(--color-text-3);
}

/* 最近变更 */
.recent-section {
  margin-bottom: 32rpx;
}

.recent-list {
  background: var(--color-card-bg);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-base);
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.recent-item:last-child {
  border-bottom: none;
}

.item-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-2));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.item-content {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.item-desc {
  font-size: 24rpx;
  color: var(--color-text-3);
}

.item-time {
  font-size: 22rpx;
  color: var(--color-text-3);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 20rpx;
  background: var(--color-card-bg);
  border-radius: 16rpx;
  box-shadow: var(--shadow-base);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-2);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-3);
}

