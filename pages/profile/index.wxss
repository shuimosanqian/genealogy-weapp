/* 用户头部 */
.profile-header {
  position: relative;
  margin-bottom: 24rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-2));
  opacity: 0.1;
}

.header-content {
  position: relative;
  padding: 32rpx 24rpx;
  background: var(--color-card-bg);
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.user-avatar {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-2));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-base);
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.avatar-badge {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  background: #4caf50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  border: 3rpx solid var(--color-card-bg);
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.user-desc {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--color-text-2);
  margin-bottom: 12rpx;
}

.desc-divider {
  margin: 0 8rpx;
  color: var(--color-text-3);
}

.user-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn.login {
  background: var(--color-brand);
  color: #fff;
}

/* 数据统计 */
.statistics-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-item {
  background: var(--color-card-bg);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-base);
}

.stat-number {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-3);
}

/* 菜单区块 */
.management-section,
.tools-section,
.help-section {
  margin-bottom: 24rpx;
}

.menu-list {
  background: var(--color-card-bg);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-base);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--color-divider);
  transition: background-color 200ms ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--color-page-bg);
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  width: 40rpx;
  text-align: center;
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.menu-desc {
  font-size: 22rpx;
  color: var(--color-text-3);
}

.menu-badge {
  padding: 4rpx 10rpx;
  background: var(--color-danger);
  color: #fff;
  border-radius: 12rpx;
  font-size: 20rpx;
  margin-right: 12rpx;
  min-width: 32rpx;
  text-align: center;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--color-text-3);
  font-weight: 300;
}

.theme-switch {
  transform: scale(0.8);
}

/* 退出登录 */
.logout-section {
  margin-top: 32rpx;
  padding-bottom: 32rpx;
}

.logout-btn {
  background: var(--color-card-bg);
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  color: var(--color-danger);
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: var(--shadow-base);
  border: 1rpx solid var(--color-divider);
}

.logout-btn:active {
  background: #fff5f5;
}

/* 登录弹窗 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
}

.modal-content {
  position: relative;
  width: 600rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
  animation: modalSlideIn 0.3s ease;
  border: 1rpx solid #e0e0e0;
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: scale(0.8) translateY(50rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-text-3);
  border-radius: 50%;
  transition: background-color 200ms ease;
}

.modal-close:active {
  background: var(--color-page-bg);
}

.modal-body {
  padding: 32rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 26rpx;
  color: var(--color-text-2);
  margin-bottom: 8rpx;
}

.login-input {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.login-input:focus {
  border-color: #2F80ED;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(47, 128, 237, 0.1);
}

.login-options {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.remember-me {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666666;
}

.forgot-password {
  font-size: 24rpx;
  color: #2F80ED;
}

.login-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.login-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 200ms ease;
}

.login-btn.primary {
  background: #2F80ED;
  color: #fff;
}

.login-btn.primary:active {
  background: #1a6fd8;
}

.login-btn.secondary {
  background: #f8f9fa;
  color: #333333;
  border: 2rpx solid #e0e0e0;
}

.login-btn.secondary:active {
  background: var(--color-divider);
}

.other-login {
  text-align: center;
}

.divider {
  position: relative;
  margin-bottom: 24rpx;
}

.divider::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1rpx;
  background: var(--color-divider);
}

.divider text {
  background: #ffffff;
  padding: 0 16rpx;
  font-size: 22rpx;
  color: #999999;
}

.social-login {
  display: flex;
  justify-content: center;
}

.social-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: #f8f9fa;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666666;
  transition: all 200ms ease;
}

.social-btn:active {
  background: var(--color-divider);
}

.social-icon {
  font-size: 28rpx;
}

/* 响应式适配 */
@media screen and (max-width: 375px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .stat-item {
    padding: 20rpx 12rpx;
  }
  
  .stat-number {
    font-size: 32rpx;
  }
  
  .modal-content {
    width: 90%;
    margin: 0 20rpx;
  }
}



