/* 成员头部 */
.member-header {
  position: relative;
  margin-bottom: 24rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-2));
  opacity: 0.1;
}

.header-content {
  position: relative;
  padding: 32rpx 24rpx 24rpx;
  background: var(--color-card-bg);
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.member-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-2));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-base);
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.member-meta {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--color-text-2);
}

.meta-divider {
  margin: 0 8rpx;
  color: var(--color-text-3);
}

.member-tags {
  display: flex;
  gap: 8rpx;
}

.member-tag {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.member-tag.status {
  background: #e8f5e8;
  color: #4caf50;
}

.member-tag.role {
  background: #e3f2fd;
  color: #2196f3;
}

/* 标签页 */
.tabs-container {
  background: var(--color-card-bg);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-base);
}

.tabs-header {
  display: flex;
  background: var(--color-page-bg);
  border-bottom: 1rpx solid var(--color-divider);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  transition: all 200ms ease;
}

.tab-item.active {
  background: var(--color-card-bg);
  border-bottom: 3rpx solid var(--color-brand);
}

.tab-icon {
  font-size: 24rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 22rpx;
  color: var(--color-text-2);
}

.tab-item.active .tab-text {
  color: var(--color-brand);
  font-weight: 600;
}

.tabs-content {
  padding: 24rpx;
}

/* 信息区块 */
.info-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.info-list {
  background: var(--color-page-bg);
  border-radius: 12rpx;
  overflow: hidden;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--color-text-2);
}

.info-value {
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 500;
}

/* 空状态 */
.timeline-empty,
.photo-empty,
.doc-empty {
  text-align: center;
  padding: 60rpx 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-2);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-3);
  margin-bottom: 24rpx;
}

.empty-btn {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: var(--color-brand);
  color: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
}

/* 底部操作按钮 */
.action-buttons {
  display: flex;
  gap: 12rpx;
  padding: 24rpx 0;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  transition: all 200ms ease;
}

.action-btn.primary {
  background: var(--color-brand);
  color: #fff;
}

.action-btn.secondary {
  background: var(--color-brand-2);
  color: #fff;
}

.action-btn.tertiary {
  background: var(--color-page-bg);
  color: var(--color-text-2);
  border: 1rpx solid var(--color-divider);
}

.action-btn:active {
  transform: scale(0.98);
}

.btn-icon {
  font-size: 24rpx;
  margin-bottom: 6rpx;
}

.action-btn text:last-child {
  font-size: 22rpx;
}

