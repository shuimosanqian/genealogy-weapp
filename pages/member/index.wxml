<view class="container {{__theme__==='dark'?'theme-dark':''}}">
  <view class="header card" style="padding: 24rpx; display:flex; gap: 16rpx;">
    <image class="avatar" src="" mode="aspectFill"></image>
    <view style="flex:1;">
      <view style="font-size: 36rpx; font-weight: 700;">张三</view>
      <view style="color:#666; margin-top:8rpx;">第5代｜(1988- )｜浙江 宁波</view>
      <view style="margin-top:8rpx; display:flex; gap:8rpx;">
        <view class="tag">在世</view>
        <view class="tag">长子</view>
      </view>
    </view>
  </view>

  <view class="tabs card" style="margin-top: 16rpx;">
    <view class="tab-bar">
      <view class="tab {{activeTab===0?'active':''}}" data-index="0" bindtap="onTab">资料</view>
      <view class="tab {{activeTab===1?'active':''}}" data-index="1" bindtap="onTab">时间轴</view>
      <view class="tab {{activeTab===2?'active':''}}" data-index="2" bindtap="onTab">合影</view>
      <view class="tab {{activeTab===3?'active':''}}" data-index="3" bindtap="onTab">文档</view>
    </view>
    <view style="padding: 20rpx;" wx:if="{{activeTab===0}}">
      <view class="section-title">基本信息</view>
      <view class="text-secondary">性别：男</view>
      <view class="text-secondary">配偶：李四</view>
      <view class="text-secondary">子女：张五、张六</view>
    </view>
    <view style="padding: 20rpx;" wx:if="{{activeTab===1}}">
      <view class="section-title">时间轴</view>
      <view class="text-secondary">暂无事件</view>
    </view>
    <view style="padding: 20rpx;" wx:if="{{activeTab===2}}">
      <view class="section-title">合影</view>
      <view class="text-secondary">暂无图片</view>
    </view>
    <view style="padding: 20rpx;" wx:if="{{activeTab===3}}">
      <view class="section-title">文档</view>
      <view class="text-secondary">暂无文档</view>
    </view>
  </view>

  <view class="fixed-actions">
    <button class="btn-primary">编辑资料</button>
    <button>添加关系</button>
  </view>
</view>

