/* 表单样式优化 */
.input {
  height: 72rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.input:focus {
  border-color: #2F80ED;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(47, 128, 237, 0.1);
}

.chip {
  padding: 12rpx 16rpx;
  background: #f5f7fb;
  border-radius: 999rpx;
  color: #666666;
  font-size: 26rpx;
  border: 2rpx solid #e0e0e0;
}

.btn-ghost {
  padding: 16rpx 24rpx;
  background: #f8f9fa;
  color: #333333;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: 2rpx solid #e0e0e0;
  transition: all 200ms ease;
}

.btn-ghost:active {
  background: #e9ecef;
  transform: scale(0.98);
}

/* 保存按钮区域 */
.save-section {
  margin-top: 48rpx;
  padding: 0 24rpx 32rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 200ms ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.save-btn.primary {
  background: linear-gradient(135deg, #2F80ED, #1a6fd8);
  color: #ffffff;
}

.save-btn.primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.btn-icon {
  font-size: 28rpx;
}

/* 表单布局优化 */
.form-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.form-card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
  overflow: hidden;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  min-width: 120rpx;
  margin-right: 16rpx;
}

.input {
  flex: 1;
  height: 72rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.input:focus {
  border-color: #2F80ED;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(47, 128, 237, 0.1);
}

.picker-chip {
  padding: 12rpx 16rpx;
  background: #f5f7fb;
  border-radius: 12rpx;
  color: #666666;
  font-size: 26rpx;
  border: 2rpx solid #e0e0e0;
  min-width: 200rpx;
  text-align: center;
  flex: 1;
}